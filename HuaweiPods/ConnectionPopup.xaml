<Window
    x:Class="HuaweiPods.ConnectionPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="耳机已连接">
    <Grid x:Name="LayoutRoot" Padding="16" ColumnSpacing="14" Opacity="0" AutomationProperties.Name="耳机已连接">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Assets/Interface/UpstreamIcons.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style x:Key="BatteryLabel" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
                <Style x:Key="BatteryValue" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style x:Key="BatteryIcon" TargetType="Image">
                    <Setter Property="Width" Value="17" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Height="66" VerticalAlignment="Center">
            <Image x:Name="Artwork" Stretch="Uniform" Visibility="Collapsed"
                   AutomationProperties.Name="耳机图片" />
            <ContentControl x:Name="ArtworkPlaceholder" Width="28" Height="28" IsTabStop="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Template="{StaticResource UpstreamHeadphonesIconTemplate}" />
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
            <TextBlock x:Name="DeviceTitle" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="ChargingCaseColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="LeftBatteryLabel" Text="左耳" Style="{StaticResource BatteryLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image x:Name="LeftBatteryIcon" Style="{StaticResource BatteryIcon}" />
                        <TextBlock x:Name="LeftBatteryValue" Text="—" Style="{StaticResource BatteryValue}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="RightBatteryLabel" Text="右耳" Style="{StaticResource BatteryLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image x:Name="RightBatteryIcon" Style="{StaticResource BatteryIcon}" />
                        <TextBlock x:Name="RightBatteryValue" Text="—" Style="{StaticResource BatteryValue}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="ChargingCase" Grid.Column="2">
                    <TextBlock Text="充电盒" Style="{StaticResource BatteryLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image x:Name="CaseBatteryIcon" Style="{StaticResource BatteryIcon}" />
                        <TextBlock x:Name="CaseBatteryValue" Text="—" Style="{StaticResource BatteryValue}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
